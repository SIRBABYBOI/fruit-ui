{
  "name": "fruitui",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "^6"
  },
  "peerDependencies": {},
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/playground dev",
    "build": "bun run --cwd apps/playground build",
    "build:packages": "bun run --cwd packages/core build && bun run --cwd packages/react build && bun run --cwd packages/zig-bridge build",
    "typecheck": "bun run --cwd apps/playground tsc -b && bunx tsc --noEmit -p packages/react/tsconfig.json && bunx tsc --noEmit -p packages/zig-bridge/tsconfig.json",
    "version-packages": "changeset version && bun install --lockfile-only"
  }
}
