{
  "name": "@fruitui/react",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/SIRBABYBOI/fruit-ui.git", "directory": "packages/react" },
  "publishConfig": { "access": "public" },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external @fruitui/core && tailwindcss -i src/styles.css -o dist/styles.css --minify"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fruitui/core": "^0.1.0-alpha.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "lucide-react": "^0.468.0",
    "react-resizable-panels": "^4.19.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
